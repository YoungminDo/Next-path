HELLOMYME_ENV=development
HELLOMYME_DATABASE_URL=postgresql+psycopg://hellomyme:hellomyme@localhost:5432/hellomyme
# Decision Q2: production must be ["SEED","VERIFIED"]; the app refuses to start otherwise.
HELLOMYME_CAREER_MAP_DATA_LAYERS=["PRE_SEED","SEED","VERIFIED"]
# Kakao login goes through HMM ID (company IdP). Production: ["HMM_ID"] (+ "GOOGLE" later).
# DEV is refused when HELLOMYME_ENV=production.
HELLOMYME_AUTH_PROVIDERS=["HMM_ID","DEV"]
# Local hmm-id dev server runs on :3000 (this web app runs on :3001). Production: https://id.da-sh.io
HELLOMYME_HMM_ID_BASE_URL=http://localhost:3000
HELLOMYME_GOOGLE_CLIENT_ID=
# The browser talks to the Next.js proxy, not to this API, so CORS is only for tools.
HELLOMYME_CORS_ORIGINS=["http://localhost:3001"]
