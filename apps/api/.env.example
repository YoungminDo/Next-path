HELLOMYME_ENV=development
HELLOMYME_DATABASE_URL=postgresql+psycopg://hellomyme:hellomyme@localhost:5432/hellomyme
# Decision Q2: production must be ["SEED","VERIFIED"]; the app refuses to start otherwise.
HELLOMYME_CAREER_MAP_DATA_LAYERS=["PRE_SEED","SEED","VERIFIED"]
# Decision Q6: KAKAO + GOOGLE in production. DEV is refused when HELLOMYME_ENV=production.
HELLOMYME_AUTH_PROVIDERS=["DEV"]
HELLOMYME_GOOGLE_CLIENT_ID=
HELLOMYME_CORS_ORIGINS=["http://localhost:3000"]
