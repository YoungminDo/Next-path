# ── server-only (never exposed to the browser) ──
# FastAPI base URL
HELLOMYME_API_URL=http://localhost:8000
# HMM ID (company IdP that runs Kakao login). Local hmm-id dev server: http://localhost:3000
HMM_ID_BASE_URL=https://id.da-sh.io
# Public origin of this app; must be registered as an SP origin in hmm-id src/lib/sp-registry.ts
APP_ORIGIN=http://localhost:3001
# Local development only — ignored in production builds
ENABLE_DEV_LOGIN=true

# ── public ──
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
NEXT_PUBLIC_CONSENT_POLICY_VERSION=career_terms_v1
